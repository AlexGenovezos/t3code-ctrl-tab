--- /dev/null
+++ b/apps/web/src/components/ThreadSwitcher.logic.test.ts
@@ -0,0 +1,62 @@
+import { describe, expect, it } from "vite-plus/test";
+
+import { openThreadSwitcher, recordRecentThread, stepThreadSwitcher } from "./ThreadSwitcher.logic";
+
+const available = () => true;
+
+describe("recordRecentThread", () => {
+  it("moves a reopened thread to the front", () => {
+    expect(recordRecentThread(["a", "b", "c"], "c")).toEqual(["c", "a", "b"]);
+  });
+});
+
+describe("openThreadSwitcher", () => {
+  it("lands on the previous thread going forward and the oldest in reverse", () => {
+    const input = {
+      recentThreadKeys: ["cur", "a", "b"],
+      currentThreadKey: "cur",
+      isAvailable: available,
+    };
+    expect(openThreadSwitcher({ ...input, direction: "forward" })).toEqual({
+      threadKeys: ["cur", "a", "b"],
+      index: 1,
+    });
+    expect(openThreadSwitcher({ ...input, direction: "reverse" })?.index).toBe(2);
+  });
+
+  it("skips threads that no longer exist", () => {
+    expect(
+      openThreadSwitcher({
+        recentThreadKeys: ["cur", "gone", "a"],
+        currentThreadKey: "cur",
+        isAvailable: (key) => key !== "gone",
+        direction: "forward",
+      }),
+    ).toEqual({ threadKeys: ["cur", "a"], index: 1 });
+  });
+
+  it("starts at either end when no thread is open", () => {
+    const input = { recentThreadKeys: ["a", "b"], currentThreadKey: null, isAvailable: available };
+    expect(openThreadSwitcher({ ...input, direction: "forward" })?.index).toBe(0);
+    expect(openThreadSwitcher({ ...input, direction: "reverse" })?.index).toBe(1);
+  });
+
+  it("does not open with nothing to switch to", () => {
+    expect(
+      openThreadSwitcher({
+        recentThreadKeys: ["cur"],
+        currentThreadKey: "cur",
+        isAvailable: available,
+        direction: "forward",
+      }),
+    ).toBeNull();
+  });
+});
+
+describe("stepThreadSwitcher", () => {
+  it("wraps around in both directions", () => {
+    const session = { threadKeys: ["cur", "a", "b"], index: 2 };
+    expect(stepThreadSwitcher(session, "forward").index).toBe(0);
+    expect(stepThreadSwitcher({ ...session, index: 0 }, "reverse").index).toBe(2);
+  });
+});
