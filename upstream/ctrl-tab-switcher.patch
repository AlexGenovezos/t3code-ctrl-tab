--- /dev/null
+++ b/apps/web/src/components/ThreadSwitcher.logic.ts
@@ -0,0 +1,48 @@
+const RECENT_THREADS_LIMIT = 30;
+
+/** Moves `threadKey` to the front of the most-recently-opened list. */
+export function recordRecentThread(keys: readonly string[], threadKey: string): readonly string[] {
+  if (keys[0] === threadKey) return keys;
+  return [threadKey, ...keys.filter((key) => key !== threadKey)].slice(0, RECENT_THREADS_LIMIT);
+}
+
+export type ThreadSwitcherDirection = "forward" | "reverse";
+
+export interface ThreadSwitcherSession {
+  /** Thread keys in switcher order: the current thread (if any) first, then most recent. */
+  readonly threadKeys: readonly string[];
+  readonly index: number;
+}
+
+/**
+ * Opens the switcher on the thread the first press lands on: the previously
+ * opened thread going forward, the oldest one in reverse. Null when there is
+ * nowhere to switch to.
+ */
+export function openThreadSwitcher(input: {
+  readonly recentThreadKeys: readonly string[];
+  readonly currentThreadKey: string | null;
+  readonly isAvailable: (threadKey: string) => boolean;
+  readonly direction: ThreadSwitcherDirection;
+}): ThreadSwitcherSession | null {
+  const others = input.recentThreadKeys.filter(
+    (key) => key !== input.currentThreadKey && input.isAvailable(key),
+  );
+  if (others.length === 0) return null;
+  if (input.currentThreadKey === null || !input.isAvailable(input.currentThreadKey)) {
+    return { threadKeys: others, index: input.direction === "forward" ? 0 : others.length - 1 };
+  }
+  const threadKeys = [input.currentThreadKey, ...others];
+  return { threadKeys, index: stepIndex(0, threadKeys.length, input.direction) };
+}
+
+export function stepThreadSwitcher(
+  session: ThreadSwitcherSession,
+  direction: ThreadSwitcherDirection,
+): ThreadSwitcherSession {
+  return { ...session, index: stepIndex(session.index, session.threadKeys.length, direction) };
+}
+
+function stepIndex(index: number, length: number, direction: ThreadSwitcherDirection): number {
+  return (index + (direction === "forward" ? 1 : -1) + length) % length;
+}
