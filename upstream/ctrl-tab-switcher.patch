diff --git a/apps/web/src/components/ThreadSwitcher.tsx b/apps/web/src/components/ThreadSwitcher.tsx
new file mode 100644
index 00000000..9a140e4e
--- /dev/null
+++ b/apps/web/src/components/ThreadSwitcher.tsx
@@ -0,0 +1,221 @@
+import { useAtomValue } from "@effect/atom-react";
+import {
+  parseScopedThreadKey,
+  scopedThreadKey,
+  scopeThreadRef,
+} from "@t3tools/client-runtime/environment";
+import { useNavigate } from "@tanstack/react-router";
+import { MessageSquareIcon } from "lucide-react";
+import { useEffect, useRef, useState } from "react";
+import { create } from "zustand";
+
+import { isCommandPaletteOpen } from "../commandPaletteBus";
+import { isElectron } from "../env";
+import { useThreadRouteRef } from "../hooks/useThreadRouteTarget";
+import { resolveShortcutCommand } from "../keybindings";
+import { cn } from "../lib/utils";
+import { textDirection } from "../textDirection";
+import { isTerminalFocused } from "../lib/terminalFocus";
+import { isModelPickerOpen } from "../modelPickerVisibility";
+import { readThreadShell, useQuietThreadShells } from "../state/entities";
+import { primaryServerKeybindingsAtom } from "../state/server";
+import { buildThreadRouteParams } from "../threadRoutes";
+import { ITEM_ICON_CLASS } from "./CommandPalette.logic";
+import { useEnvironmentLookups, useProjectLookups } from "./CommandPaletteLookups";
+import { CommandPaletteTitleIcon } from "./CommandPaletteResults";
+import { useProviderEntryByEnvironmentAndInstanceId } from "./CommandPaletteThreadItems";
+import { ProjectFavicon } from "./ProjectFavicon";
+import { ThreadCommandSubtitle } from "./ThreadCommandSubtitle";
+import { ThreadRowLeadingStatus, ThreadRowTrailingStatus } from "./ThreadStatusIndicators";
+import {
+  openThreadSwitcher,
+  recordRecentThread,
+  stepThreadSwitcher,
+  type ThreadSwitcherSession,
+} from "./ThreadSwitcher.logic";
+
+/** Scoped thread keys, most recently opened first, for this window's session. */
+const useRecentThreadsStore = create<{
+  readonly threadKeys: readonly string[];
+  readonly recordThreadOpened: (threadKey: string) => void;
+}>()((set) => ({
+  threadKeys: [],
+  recordThreadOpened: (threadKey) =>
+    set((state) => ({ threadKeys: recordRecentThread(state.threadKeys, threadKey) })),
+}));
+
+function isThreadAvailable(threadKey: string): boolean {
+  const ref = parseScopedThreadKey(threadKey);
+  return ref !== null && readThreadShell(ref) !== null;
+}
+
+/**
+ * Ctrl+Tab thread switching: holding the modifier and pressing the shortcut
+ * walks the most recently opened threads, and releasing the modifier opens the
+ * highlighted one. Browsers keep Ctrl+Tab for their own tabs, so the default
+ * binding only reaches the page in the desktop app.
+ */
+export function ThreadSwitcher() {
+  const routeThreadRef = useThreadRouteRef();
+  const routeThreadKey = routeThreadRef ? scopedThreadKey(routeThreadRef) : null;
+  const recordThreadOpened = useRecentThreadsStore((store) => store.recordThreadOpened);
+  const keybindings = useAtomValue(primaryServerKeybindingsAtom);
+  const navigate = useNavigate();
+  const [session, setSessionState] = useState<ThreadSwitcherSession | null>(null);
+  // Key listeners read the open session synchronously between renders.
+  const sessionRef = useRef(session);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- records route visits into the recent-thread order the switcher walks
+  useEffect(() => {
+    if (routeThreadKey !== null) recordThreadOpened(routeThreadKey);
+  }, [recordThreadOpened, routeThreadKey]);
+
+  // oxlint-disable-next-line t3code/no-unreasoned-state-sync -- subscribes to window key events for the switcher shortcut and modifier release
+  useEffect(() => {
+    const setSession = (next: ThreadSwitcherSession | null) => {
+      sessionRef.current = next;
+      setSessionState(next);
+    };
+    const commit = () => {
+      const current = sessionRef.current;
+      setSession(null);
+      const targetKey = current?.threadKeys[current.index];
+      const ref = targetKey === undefined ? null : parseScopedThreadKey(targetKey);
+      if (ref === null || targetKey === routeThreadKey) return;
+      void navigate({ to: "/$environmentId/$threadId", params: buildThreadRouteParams(ref) });
+    };
+    const onKeyDown = (event: KeyboardEvent) => {
+      const current = sessionRef.current;
+      if (current !== null && event.key === "Escape") {
+        event.preventDefault();
+        event.stopPropagation();
+        setSession(null);
+        return;
+      }
+      if (current === null && (isCommandPaletteOpen() || isModelPickerOpen())) return;
+      const command = resolveShortcutCommand(event, keybindings, {
+        platform: navigator.platform,
+        context: { terminalFocus: isTerminalFocused(), isWeb: !isElectron, isDesktop: isElectron },
+      });
+      if (command !== "thread.switchRecent" && command !== "thread.switchRecentReverse") return;
+      const direction = command === "thread.switchRecent" ? "forward" : "reverse";
+      event.preventDefault();
+      event.stopPropagation();
+      setSession(
+        current !== null
+          ? stepThreadSwitcher(current, direction)
+          : openThreadSwitcher({
+              recentThreadKeys: useRecentThreadsStore.getState().threadKeys,
+              currentThreadKey: routeThreadKey,
+              isAvailable: isThreadAvailable,
+              direction,
+            }),
+      );
+    };
+    const onKeyUp = (event: KeyboardEvent) => {
+      if (sessionRef.current === null) return;
+      if (!event.ctrlKey && !event.metaKey && !event.altKey) commit();
+    };
+    const onBlur = () => setSession(null);
+    window.addEventListener("keydown", onKeyDown, true);
+    window.addEventListener("keyup", onKeyUp, true);
+    window.addEventListener("blur", onBlur);
+    return () => {
+      window.removeEventListener("keydown", onKeyDown, true);
+      window.removeEventListener("keyup", onKeyUp, true);
+      window.removeEventListener("blur", onBlur);
+    };
+  }, [keybindings, navigate, routeThreadKey]);
+
+  return session === null ? null : (
+    <ThreadSwitcherList session={session} currentThreadKey={routeThreadKey} />
+  );
+}
+
+// Mounted only while the switcher is open, so closed it subscribes to nothing.
+// Rows mirror the command palette's thread rows.
+function ThreadSwitcherList({
+  session,
+  currentThreadKey,
+}: {
+  session: ThreadSwitcherSession;
+  currentThreadKey: string | null;
+}) {
+  const threads = useQuietThreadShells();
+  const { projectByKey } = useProjectLookups();
+  const { projectEnvironmentLocationById } = useEnvironmentLookups();
+  const providerEntryByEnvironmentAndInstanceId = useProviderEntryByEnvironmentAndInstanceId();
+  const threadByKey = new Map(
+    threads.map(
+      (thread) =>
+        [scopedThreadKey(scopeThreadRef(thread.environmentId, thread.id)), thread] as const,
+    ),
+  );
+  return (
+    <div className="pointer-events-none fixed inset-0 z-50 flex flex-col items-center px-4 pt-16 sm:pt-24">
+      <ul
+        aria-label="Recent threads"
+        className="dialog-glass max-h-105 w-full max-w-xl overflow-y-auto rounded-2xl border p-2 text-foreground"
+      >
+        {session.threadKeys.map((threadKey, index) => {
+          const thread = threadByKey.get(threadKey);
+          if (!thread) return null;
+          const project = projectByKey.get(`${thread.environmentId}:${thread.projectId}`) ?? null;
+          const modelInstanceId =
+            thread.runtime?.providerInstanceId ?? thread.modelSelection.instanceId;
+          const providerEntry = providerEntryByEnvironmentAndInstanceId.get(
+            `${thread.environmentId}:${modelInstanceId}`,
+          );
+          const providerDisplayName =
+            thread.runtime?.providerName ?? providerEntry?.displayName ?? modelInstanceId;
+          return (
+            <li
+              key={threadKey}
+              data-active={index === session.index || undefined}
+              ref={
+                index === session.index
+                  ? (node) => node?.scrollIntoView({ block: "nearest" })
+                  : undefined
+              }
+              className={cn(
+                "flex min-h-8 select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm",
+                index === session.index && "bg-accent text-accent-foreground",
+              )}
+            >
+              <CommandPaletteTitleIcon>
+                {project ? (
+                  <ProjectFavicon project={project} className="size-4 shrink-0" />
+                ) : (
+                  <MessageSquareIcon className={ITEM_ICON_CLASS} />
+                )}
+              </CommandPaletteTitleIcon>
+              <span className="flex min-w-0 flex-1 flex-col">
+                <span className="flex min-w-0 items-center gap-1.5 text-foreground">
+                  <ThreadRowLeadingStatus thread={thread} />
+                  <span className="truncate" dir={textDirection(thread.title)}>
+                    {thread.title}
+                  </span>
+                </span>
+                <ThreadCommandSubtitle
+                  project={null}
+                  projectTitle={project?.title ?? null}
+                  environmentLabel={
+                    projectEnvironmentLocationById.get(thread.environmentId)?.label ?? "Remote"
+                  }
+                  branch={thread.branch}
+                  worktreePath={thread.worktreePath}
+                  isCurrent={threadKey === currentThreadKey}
+                  driverKind={providerEntry?.driverKind ?? null}
+                  providerDisplayName={providerDisplayName}
+                  acpRegistryAgentId={providerEntry?.acpRegistryAgentId}
+                  acpRegistryIconUrl={providerEntry?.acpRegistryIconUrl}
+                />
+              </span>
+              <ThreadRowTrailingStatus thread={thread} />
+            </li>
+          );
+        })}
+      </ul>
+    </div>
+  );
+}
diff --git a/apps/web/src/components/ThreadSwitcher.logic.ts b/apps/web/src/components/ThreadSwitcher.logic.ts
